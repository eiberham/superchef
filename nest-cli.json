{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "backend/superchef/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "backend/superchef/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "backend",
  "projects": {
    "analytics": {
      "type": "application",
      "root": "backend/analytics",
      "entryFile": "main",
      "sourceRoot": "backend/analytics/src",
      "compilerOptions": {
        "tsConfigPath": "backend/analytics/tsconfig.app.json"
      }
    },
    "notifications": {
      "type": "application",
      "root": "backend/notifications",
      "entryFile": "main",
      "sourceRoot": "backend/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "backend/notifications/tsconfig.app.json"
      }
    },
    "superchef": {
      "type": "application",
      "root": "backend/superchef",
      "entryFile": "main",
      "sourceRoot": "backend/superchef/src",
      "compilerOptions": {
        "tsConfigPath": "backend/superchef/tsconfig.app.json"
      }
    }
  }
}